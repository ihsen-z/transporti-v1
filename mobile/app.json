{
  "expo": {
    "name": "Transporti",
    "slug": "transporti-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "transporti",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "tn.transporti.app"
    },
    "android": {
      "package": "tn.transporti.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Transporti accède à vos photos pour envoyer vos documents de vérification.",
          "cameraPermission": "Transporti accède à la caméra pour photographier vos documents."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Transporti utilise votre position pour vous situer sur la carte des retours disponibles."
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
