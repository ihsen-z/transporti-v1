{
  "expo": {
    "name": "Transporti",
    "slug": "transporti-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "transporti",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "tn.transporti.app"
    },
    "android": {
      "package": "tn.transporti.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Transporti accède à vos photos pour envoyer vos documents de vérification.",
          "cameraPermission": "Transporti accède à la caméra pour photographier vos documents."
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
