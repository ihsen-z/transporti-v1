# Copier en .env (jamais commité). Les variables EXPO_PUBLIC_* sont exposées
# au bundle client — n'y mettre AUCUN secret, uniquement des valeurs publiques.

# Base URL de l'API backend (préfixe /api/v1 ajouté par le client).
# Dev émulateur Android : http://10.0.2.2:8000  |  iOS simulateur : http://localhost:8000
# Staging Render : https://<votre-service>.onrender.com
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Timeout des requêtes HTTP (ms)
EXPO_PUBLIC_API_TIMEOUT=15000

# DSN Sentry. Laisser VIDE désactive proprement l'observabilité : l'app
# fonctionne, les erreurs partent simplement dans la console.
# Valeur publique par nature (elle finit dans le bundle) — ce n'est pas un secret.
EXPO_PUBLIC_SENTRY_DSN=

# ─────────────────────────────────────────────────────────────────────────────
# Variables de BUILD (non préfixées EXPO_PUBLIC_ : elles ne sont pas exposées
# au bundle, elles sont lues par app.config.js au moment du build).
# ─────────────────────────────────────────────────────────────────────────────

# Clé Google Maps Android. Elle finit dans l'AndroidManifest de l'APK, donc
# lisible par qui décompile le binaire : la protection réelle se fait côté
# Google Cloud en restreignant la clé au package `tn.transporti.app` ET à
# l'empreinte SHA-1 du certificat de signature EAS
# (`eas credentials` → Android → Keystore → SHA-1).
GOOGLE_MAPS_ANDROID_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Secrets à provisionner HORS de ce fichier
# ─────────────────────────────────────────────────────────────────────────────
#
# GitHub Actions (Settings → Secrets and variables → Actions) :
#   EXPO_TOKEN            jeton de compte Expo, pour `eas build` depuis la CI
#   SENTRY_AUTH_TOKEN     upload des source maps au build
#
# EAS (`eas secret:create`) :
#   GOOGLE_MAPS_ANDROID_API_KEY   clé de production restreinte
#
# Notes d'environnement :
# - `eas.json` profil `preview` pointe sur un service Render de STAGING qui
#   n'existe pas encore dans `render.yaml` (seul `transporti-backend` y est
#   défini). À créer avant la première diffusion QA, sinon les testeurs
#   travailleraient sur la base de production.

# Pages legales et aide (lot 2, tache 2.3). Un lien de politique de
# confidentialite est OBLIGATOIRE pour publier sur Google Play et l'App Store.
# Vide = l'entree correspondante n'apparait pas dans le menu du profil.
EXPO_PUBLIC_TERMS_URL=https://transporti.tn/conditions
EXPO_PUBLIC_PRIVACY_URL=https://transporti.tn/confidentialite
EXPO_PUBLIC_HELP_URL=https://transporti.tn/aide
